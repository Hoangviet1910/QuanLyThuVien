@model QuanLyThuVien.Models.NhaXuatBan

@{
    ViewData["Title"] = "Thêm Nhà Xuất Bản";
}

<h2><i class="fas fa-plus-circle text-primary me-2"></i> Thêm Nhà Xuất Bản</h2>
<hr />

<div class="row">
    <div class="col-lg-7">
        <div class="card shadow">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <partial name="_NxbFields" model="Model" />
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Lưu</button>
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
