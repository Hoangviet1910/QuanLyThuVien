@model QuanLyThuVien.Models.BanDoc

@{
    ViewData["Title"] = "Thêm Bạn Đọc";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="fas fa-user-plus me-2 text-primary"></i> Thêm Bạn Đọc Mới</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Quay lại</a>
</div>

<form asp-action="Create" method="post">
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white fw-bold"><i class="fas fa-id-card me-2 text-primary"></i>Thông tin bạn đọc &amp; thẻ</div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row g-3">
                        <partial name="_BanDocFields" model="Model" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white fw-bold"><i class="fas fa-key me-2 text-primary"></i>Tài khoản đăng nhập</div>
                <div class="card-body">
                    <p class="small text-muted">Hệ thống tự tạo tài khoản (vai trò Bạn đọc) cho bạn đọc này.</p>
                    <div class="mb-3">
                        <label class="form-label">Tên đăng nhập</label>
                        <input name="tenDangNhap" value="@ViewData["TenDangNhap"]" class="form-control" placeholder="Bỏ trống = dùng số điện thoại" maxlength="50" />
                        @Html.ValidationMessage("TenDangNhap", new { @class = "text-danger" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu</label>
                        <input name="matKhau" class="form-control" placeholder="Bỏ trống = 123456" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-save me-1"></i> Lưu bạn đọc</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
