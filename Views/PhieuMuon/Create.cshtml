@model QuanLyThuVien.ViewModels.PhieuMuonCreateViewModel

@{
    ViewData["Title"] = "Tạo Phiếu Mượn";
    var sachs = (List<QuanLyThuVien.Models.Sach>)ViewData["Sachs"]!;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="fas fa-file-circle-plus me-2 text-primary"></i> Tạo Phiếu Mượn Sách</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Quay lại</a>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="alert alert-danger py-2"></div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white fw-bold"><i class="fas fa-user me-2 text-primary"></i>Thông tin phiếu</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="MaBanDoc" class="form-label required">Bạn đọc</label>
                        <select asp-for="MaBanDoc" asp-items="ViewBag.MaBanDoc" class="form-select">
                            <option value="">-- Chọn bạn đọc (thẻ còn hạn) --</option>
                        </select>
                        <span asp-validation-for="MaBanDoc" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ngày mượn</label>
                        <input class="form-control" value="@DateTime.Now.ToString("dd/MM/yyyy")" disabled />
                    </div>
                    <div class="mb-3">
                        <label asp-for="HanTra" class="form-label required">Hạn trả</label>
                        <input asp-for="HanTra" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                        <span asp-validation-for="HanTra" class="text-danger"></span>
                        <div class="form-text">Phạt 5.000 VNĐ / ngày / cuốn nếu trả trễ.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="GhiChu" class="form-label">Ghi chú</label>
                        <textarea asp-for="GhiChu" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="alert alert-info py-2 mb-3">
                        <i class="fas fa-cart-shopping me-1"></i> Đã chọn: <strong id="selCount">0</strong> cuốn
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-save me-1"></i> Lưu phiếu mượn</button>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="fw-bold"><i class="fas fa-books me-2 text-primary"></i>Chọn sách (@sachs.Count cuốn còn trong kho)</span>
                    <div class="input-group input-group-sm" style="max-width: 260px;">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" id="bookFilter" class="form-control" placeholder="Lọc theo tên sách..." />
                    </div>
                </div>
                <div class="list-group list-group-flush book-check-list">
                    @foreach (var s in sachs)
                    {
                        <label class="list-group-item list-group-item-action d-flex align-items-center gap-3 book-item" data-name="@s.TenSach.ToLower()">
                            <input type="checkbox" class="form-check-input book-check mt-0" name="SelectedBooks" value="@s.MaSach" checked="@Model.SelectedBooks.Contains(s.MaSach)" />
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@s.TenSach</div>
                                <small class="text-muted">@s.TheLoai.TenTheLoai@(string.IsNullOrWhiteSpace(s.ViTriKeSach) ? "" : " · Kệ " + s.ViTriKeSach)</small>
                            </div>
                            <span class="badge bg-success">Còn @s.SoLuongCon</span>
                        </label>
                    }
                    @if (!sachs.Any())
                    {
                        <div class="list-group-item text-center text-muted py-4">Kho hiện không còn sách để mượn.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const checks = document.querySelectorAll('.book-check');
        const counter = document.getElementById('selCount');
        function updateCount() { counter.textContent = document.querySelectorAll('.book-check:checked').length; }
        checks.forEach(c => c.addEventListener('change', updateCount));
        updateCount();

        document.getElementById('bookFilter').addEventListener('input', function () {
            const key = this.value.trim().toLowerCase();
            document.querySelectorAll('.book-item').forEach(function (it) {
                it.classList.toggle('d-none', key && !it.dataset.name.includes(key));
            });
        });
    </script>
}
