@model IEnumerable<QuanLyThuVien.Models.TheLoai>

@{
    ViewData["Title"] = "Quản Lý Thể Loại";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tags me-2"></i> Quản Lý Thể Loại</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i> Thêm mới</a>
</div>

<div class="card shadow">
    <div class="card-body">
        <table class="table table-hover table-bordered">
            <thead class="table-light">
                <tr>
                    <th>STT</th>
                    <th>Tên Thể Loại</th>
                    <th>Mô Tả</th>
                    <th>Thứ Tự</th>
                    <th>Trạng Thái</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>@item.TenTheLoai</td>
                        <td>@item.MoTa</td>
                        <td>@item.ThuTuHienThi</td>
                        <td>
                            @if (item.TrangThai)
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Tạm ẩn</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.MaTheLoai" class="btn btn-sm btn-outline-secondary" title="Chi tiết"><i class="fas fa-eye"></i></a>
                            <form asp-action="ToggleStatus" asp-route-id="@item.MaTheLoai" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(item.TrangThai ? "btn-outline-dark" : "btn-outline-success")" title="@(item.TrangThai ? "Tạm ẩn" : "Kích hoạt")"><i class="fas @(item.TrangThai ? "fa-eye-slash" : "fa-eye")"></i></button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@item.MaTheLoai" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i> Sửa</a>
                            <form asp-action="Delete" asp-route-id="@item.MaTheLoai" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa thể loại này?');">
                                <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i> Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
