@model IEnumerable<QuanLyThuVien.Models.PhieuMuon>
@using QuanLyThuVien.ViewModels

@{
    ViewData["Title"] = "Lịch Sử Mượn Sách";
    int pageNumber = (int)ViewData["PageNumber"]!;
    int totalPages = (int)ViewData["TotalPages"]!;
    int? current = ViewData["CurrentTrangThai"] as int?;
    var banDoc = (BanDoc)ViewData["BanDoc"]!;
    decimal tongPhat = (decimal)ViewData["TongPhat"]!;
    var pager = PagerViewModel.Create("LichSu", pageNumber, totalPages, ("trangThai", current));
    bool theHetHan = banDoc.HanThe.Date < DateTime.Today;

    var tabs = new List<(int? Key, string Text)>
    {
        (null, "Tất cả"), (0, "Chờ duyệt"), (1, "Đang mượn"), (4, "Quá hạn"), (2, "Đã trả"), (3, "Từ chối / Hủy")
    };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0"><i class="fas fa-clock-rotate-left me-2 text-primary"></i> Lịch Sử Mượn Sách</h2>
    <a asp-controller="Sach" asp-action="TraCuu" class="btn btn-primary"><i class="fas fa-search me-1"></i> Tra cứu &amp; mượn sách</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-8">
        <div class="alert @(theHetHan || !banDoc.TrangThai ? "alert-danger" : "alert-info") mb-0 h-100 d-flex align-items-center">
            <i class="fas fa-id-card fa-lg me-3"></i>
            <div>
                <strong>@banDoc.HoTen</strong> &middot; Thẻ #@banDoc.MaBanDoc &middot; Cấp @banDoc.NgayCapThe.ToString("dd/MM/yyyy") &middot; Hạn @banDoc.HanThe.ToString("dd/MM/yyyy")
                @if (theHetHan) { <span class="badge bg-danger ms-1">Hết hạn</span> }
                @if (!banDoc.TrangThai) { <span class="badge bg-dark ms-1">Đã khóa</span> }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-start border-danger border-4 h-100"><div class="card-body py-2">
            <div class="text-muted small text-uppercase">Tổng tiền phạt</div>
            <div class="fs-4 fw-bold @(tongPhat > 0 ? "text-danger" : "")">@tongPhat.ToString("N0") đ</div>
        </div></div>
    </div>
</div>

<ul class="nav nav-pills mb-3 flex-wrap gap-1">
    @foreach (var t in tabs)
    {
        <li class="nav-item">
            <a class="nav-link py-1 px-3 @(current == t.Key ? "active" : "")" asp-action="LichSu" asp-route-trangThai="@t.Key">@t.Text</a>
        </li>
    }
</ul>

@if (!Model.Any())
{
    <div class="card shadow-sm"><div class="card-body text-center text-muted py-5">
        <i class="fas fa-inbox fa-3x mb-3 opacity-50"></i><div>Chưa có phiếu mượn nào.</div>
    </div></div>
}

@foreach (var p in Model)
{
    <div class="card shadow-sm mb-3 @(p.TrangThai == 1 && p.HanTra < DateTime.Today ? "border border-danger" : "")">
        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <a asp-action="Details" asp-route-id="@p.MaPhieuMuon" class="fw-bold text-decoration-none">Phiếu #@p.MaPhieuMuon</a>
                <span class="text-muted small ms-2"><i class="far fa-calendar me-1"></i>@p.NgayMuon.ToString("dd/MM/yyyy")</span>
            </div>
            <partial name="_TrangThaiBadge" model="p" />
        </div>
        <div class="card-body py-2">
            @foreach (var ct in p.ChiTietMuons)
            {
                <div class="d-flex align-items-center py-1">
                    <i class="fas fa-book text-primary me-2"></i>
                    <span class="flex-grow-1">@ct.Sach.TenSach</span>
                    <span class="text-muted small">x@(ct.SoLuong)</span>
                </div>
            }
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center flex-wrap gap-2 small">
            <div class="text-muted">
                Hạn trả: <strong class="@(p.TrangThai == 1 && p.HanTra < DateTime.Today ? "text-danger" : "")">@p.HanTra.ToString("dd/MM/yyyy")</strong>
                @if (p.NgayTra.HasValue) { <span class="ms-3">Đã trả: <strong>@p.NgayTra.Value.ToString("dd/MM/yyyy")</strong></span> }
                @if (p.TienPhat > 0) { <span class="ms-3 text-danger">Tiền phạt: <strong>@p.TienPhat.ToString("N0") đ</strong></span> }
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Details" asp-route-id="@p.MaPhieuMuon" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye me-1"></i>Chi tiết</a>
                @if (p.TrangThai == 0)
                {
                    <form asp-action="HuyYeuCau" asp-route-id="@p.MaPhieuMuon" method="post" onsubmit="return confirm('Hủy yêu cầu mượn này?');">
                        <button class="btn btn-sm btn-outline-danger"><i class="fas fa-xmark me-1"></i>Hủy yêu cầu</button>
                    </form>
                }
            </div>
        </div>
    </div>
}

@if (totalPages > 1)
{
    <div class="mt-3"><partial name="_Pager" model="pager" /></div>
}
