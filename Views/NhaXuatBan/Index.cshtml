@model IEnumerable<QuanLyThuVien.Models.NhaXuatBan>

@{
    ViewData["Title"] = "Quản Lý NXB";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-building me-2"></i> Quản Lý Nhà Xuất Bản</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i> Thêm mới</a>
</div>

<div class="card shadow">
    <div class="card-body">
        <table class="table table-hover table-bordered">
            <thead class="table-light">
                <tr>
                    <th>STT</th>
                    <th>Tên NXB</th>
                    <th>Địa Chỉ</th>
                    <th>SĐT</th>
                    <th>Email</th>
                    <th class="text-end">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>@item.TenNhaXuatBan</td>
                        <td>@item.DiaChi</td>
                        <td>@item.SoDienThoai</td>
                        <td>@item.Email</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.MaNhaXuatBan" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i> Sửa</a>
                            <form asp-action="Delete" asp-route-id="@item.MaNhaXuatBan" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa nhà xuất bản này?');">
                                <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i> Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
