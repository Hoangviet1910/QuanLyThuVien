@model QuanLyThuVien.Models.BanDoc
@{
    ViewData["Title"] = "Chi tiết bạn đọc";
    bool hetHan = Model.HanThe.Date < DateTime.Today;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="fas fa-user me-2 text-primary"></i> @Model.HoTen <small class="text-muted fs-6">Thẻ #@Model.MaBanDoc</small></h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.MaBanDoc" class="btn btn-warning"><i class="fas fa-edit me-1"></i> Sửa</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Quay lại</a>
    </div>
</div>
<div class="row g-3">
    <div class="col-lg-4"><div class="card shadow-sm"><ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Giới tính</span><span>@(Model.GioiTinh == true ? "Nam" : Model.GioiTinh == false ? "Nữ" : "—")</span></li>
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Ngày sinh</span><span>@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "—")</span></li>
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">SĐT</span><span>@(Model.SoDienThoai ?? "—")</span></li>
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Email</span><span>@(Model.Email ?? "—")</span></li>
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Địa chỉ</span><span class="text-end">@(Model.DiaChi ?? "—")</span></li>
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Ngày cấp</span><span>@Model.NgayCapThe.ToString("dd/MM/yyyy")</span></li>
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Hạn thẻ</span><span class="@(hetHan ? "text-danger fw-bold" : "")">@Model.HanThe.ToString("dd/MM/yyyy")</span></li>
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Tài khoản</span><span>@(Model.TaiKhoan?.TenDangNhap ?? "—")</span></li>
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Trạng thái</span>
            @if (!Model.TrangThai) { <span class="badge bg-dark">Đã khóa</span> } else if (hetHan) { <span class="badge bg-danger">Hết hạn</span> } else { <span class="badge bg-success">Còn hạn</span> }</li>
        @if (!string.IsNullOrWhiteSpace(Model.GhiChu)) { <li class="list-group-item"><div class="text-muted small">Ghi chú</div>@Model.GhiChu</li> }
    </ul></div></div>
    <div class="col-lg-8"><div class="card shadow-sm">
        <div class="card-header bg-white fw-bold">Lịch sử mượn (@Model.PhieuMuons.Count phiếu)</div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Mã</th><th>Sách</th><th>Ngày mượn</th><th>Hạn trả</th><th>Trạng thái</th><th class="text-end">Phạt</th></tr></thead>
            <tbody>
            @foreach (var p in Model.PhieuMuons.OrderByDescending(x => x.MaPhieuMuon))
            {
                <tr>
                    <td><a asp-controller="PhieuMuon" asp-action="Details" asp-route-id="@p.MaPhieuMuon">#@p.MaPhieuMuon</a></td>
                    <td class="small">@string.Join(", ", p.ChiTietMuons.Select(c => c.Sach.TenSach))</td>
                    <td>@p.NgayMuon.ToString("dd/MM/yyyy")</td>
                    <td>@p.HanTra.ToString("dd/MM/yyyy")</td>
                    <td><partial name="_TrangThaiBadge" model="p" /></td>
                    <td class="text-end">@(p.TienPhat > 0 ? p.TienPhat.ToString("N0") + " đ" : "—")</td>
                </tr>
            }
            @if (!Model.PhieuMuons.Any()) { <tr><td colspan="6" class="text-center text-muted py-3">Chưa có phiếu mượn.</td></tr> }
            </tbody>
        </table></div>
    </div></div>
</div>
