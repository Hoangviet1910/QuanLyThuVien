@model IEnumerable<QuanLyThuVien.Models.Sach>
@using QuanLyThuVien.ViewModels

@{
    ViewData["Title"] = "Quản Lý Sách";
    int pageNumber = (int)ViewData["PageNumber"]!;
    int totalPages = (int)ViewData["TotalPages"]!;
    int totalCount = (int)ViewData["TotalCount"]!;
    var q = (SachQuery)ViewData["Query"]!;
    var pager = new PagerViewModel { Action = "Index", Page = pageNumber, TotalPages = totalPages, Base = q.ToRoute() };
    ViewData["ShowAdminFilters"] = true;
    var sortName = q.ToRoute(q.NextSort("", "name_desc"), true);
    var sortYear = q.ToRoute(q.NextSort("year", "year_desc"), true);
    var sortPrice = q.ToRoute(q.NextSort("price", "price_desc"), true);
    var sortCon = q.ToRoute(q.NextSort("con", "con_desc"), true);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="fas fa-book me-2 text-primary"></i> Quản Lý Sách</h2>
        <small class="text-muted">@totalCount đầu sách &middot; trang @pageNumber/@totalPages</small>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i> Thêm mới</a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <partial name="_FilterFields" model="q" view-data="ViewData" />
            <div class="col-lg-2 col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill"><i class="fas fa-search me-1"></i> Lọc</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc"><i class="fas fa-rotate-left"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th><a asp-action="Index" asp-all-route-data="sortName">Tên sách <i class="fas fa-sort"></i></a></th>
                    <th>Thể loại</th>
                    <th>NXB</th>
                    <th><a asp-action="Index" asp-all-route-data="sortYear">Năm <i class="fas fa-sort"></i></a></th>
                    <th class="text-end"><a asp-action="Index" asp-all-route-data="sortPrice">Đơn giá <i class="fas fa-sort"></i></a></th>
                    <th class="text-center">Tổng</th>
                    <th class="text-center"><a asp-action="Index" asp-all-route-data="sortCon">Còn <i class="fas fa-sort"></i></a></th>
                    <th>Tình trạng</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.TrangThai ? "" : "table-secondary")">
                        <td class="fw-bold"><a asp-action="Details" asp-route-id="@item.MaSach" class="text-decoration-none">@item.TenSach</a><div class="small text-muted fw-normal">@item.ViTriKeSach</div></td>
                        <td>@item.TheLoai.TenTheLoai</td>
                        <td>@item.NhaXuatBan.TenNhaXuatBan</td>
                        <td>@item.NamXuatBan</td>
                        <td class="text-end">@item.DonGia.ToString("N0") đ</td>
                        <td class="text-center">@item.SoLuong</td>
                        <td class="text-center fw-bold @(item.SoLuongCon == 0 ? "text-danger" : "text-success")">@item.SoLuongCon</td>
                        <td>
                            @if (!item.TrangThai) { <span class="badge bg-dark">Đã khóa</span> }
                            else if (item.SoLuongCon > 0) { <span class="badge bg-success">Khả dụng</span> }
                            else { <span class="badge bg-danger">Hết sách</span> }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.MaSach" class="btn btn-sm btn-outline-secondary" title="Chi tiết"><i class="fas fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.MaSach" class="btn btn-sm btn-warning" title="Sửa"><i class="fas fa-edit"></i></a>
                            <form asp-action="ToggleStatus" asp-route-id="@item.MaSach" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(item.TrangThai ? "btn-outline-dark" : "btn-outline-success")" title="@(item.TrangThai ? "Khóa sách" : "Mở lại")"><i class="fas @(item.TrangThai ? "fa-lock" : "fa-lock-open")"></i></button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@item.MaSach" method="post" class="d-inline" onsubmit="return confirm('Xóa sách này?');">
                                <button type="submit" class="btn btn-sm btn-danger" title="Xóa"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-5"><i class="fas fa-book-open fa-2x d-block mb-2 opacity-50"></i>Không tìm thấy sách nào phù hợp.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white py-3"><partial name="_Pager" model="pager" /></div>
    }
</div>
