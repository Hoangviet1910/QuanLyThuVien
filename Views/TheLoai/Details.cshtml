@model QuanLyThuVien.Models.TheLoai
@{ ViewData["Title"] = "Chi tiết thể loại"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="fas fa-tag me-2 text-primary"></i> @Model.TenTheLoai</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Quay lại</a>
</div>
<div class="row g-3">
    <div class="col-lg-4"><div class="card shadow-sm"><ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Thứ tự hiển thị</span><strong>@Model.ThuTuHienThi</strong></li>
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Trạng thái</span>@if (Model.TrangThai) { <span class="badge bg-success">Hoạt động</span> } else { <span class="badge bg-secondary">Tạm ẩn</span> }</li>
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Số đầu sách</span><strong>@Model.Sachs.Count</strong></li>
        <li class="list-group-item"><div class="text-muted small">Mô tả</div>@(string.IsNullOrWhiteSpace(Model.MoTa) ? "—" : Model.MoTa)</li>
    </ul></div></div>
    <div class="col-lg-8"><div class="card shadow-sm">
        <div class="card-header bg-white fw-bold">Sách thuộc thể loại</div>
        <div class="table-responsive"><table class="table mb-0">
            <thead class="table-light"><tr><th>Tên sách</th><th class="text-center">Tổng</th><th class="text-center">Còn</th></tr></thead>
            <tbody>
            @foreach (var s in Model.Sachs.OrderBy(x => x.TenSach))
            {
                <tr><td>@s.TenSach</td><td class="text-center">@s.SoLuong</td><td class="text-center">@s.SoLuongCon</td></tr>
            }
            @if (!Model.Sachs.Any()) { <tr><td colspan="3" class="text-center text-muted py-3">Chưa có sách.</td></tr> }
            </tbody>
        </table></div>
    </div></div>
</div>
