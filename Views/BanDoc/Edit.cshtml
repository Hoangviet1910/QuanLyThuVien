@model QuanLyThuVien.Models.BanDoc

@{
    ViewData["Title"] = "Sửa Bạn Đọc";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="fas fa-user-pen me-2 text-warning"></i> Sửa Thông Tin Bạn Đọc</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Quay lại</a>
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MaBanDoc" />
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white fw-bold"><i class="fas fa-id-card me-2 text-primary"></i>Thông tin bạn đọc &amp; thẻ #@Model.MaBanDoc</div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row g-3">
                        <partial name="_BanDocFields" model="Model" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white fw-bold"><i class="fas fa-key me-2 text-primary"></i>Tài khoản đăng nhập</div>
                <div class="card-body">
                    @if (Model.TaiKhoan != null)
                    {
                        <div class="mb-3">
                            <label class="form-label">Tên đăng nhập</label>
                            <input class="form-control" value="@Model.TaiKhoan.TenDangNhap" disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Đặt lại mật khẩu</label>
                            <input name="matKhauMoi" class="form-control" placeholder="Bỏ trống = giữ nguyên" />
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning py-2 small mb-3">Bạn đọc này chưa có tài khoản đăng nhập.</div>
                    }
                    <button type="submit" class="btn btn-warning w-100"><i class="fas fa-save me-1"></i> Cập nhật</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
